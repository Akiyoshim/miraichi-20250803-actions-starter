# 生成AIプロバイダの種類（MVPでは gemini 固定）
AI_PROVIDER=gemini
# Gemini APIキー（取得先: Google AI Studio https://aistudio.google.com/apikey）
GEMINI_API_KEY=
# 使用するGeminiのモデル名（モデルは廃止されることがある。エラーになったら https://ai.google.dev/gemini-api/docs/models で現行モデル名を確認して差し替える）
AI_MODEL=gemini-3.6-flash
# ResendのAPIキー（取得先: Resendダッシュボード https://resend.com/api-keys）
RESEND_API_KEY=
# メールの送信元アドレス（Resendのテスト用送信元。独自ドメイン検証は任意）
EMAIL_FROM=onboarding@resend.dev
# 要約メールの送信先アドレス（自分が受け取りたいメールアドレス）
EMAIL_TO=
